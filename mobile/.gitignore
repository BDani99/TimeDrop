# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. key.properties holds the keystore passwords in plain text,
# and the keystore is the one file that cannot be regenerated.
/android/key.properties
*.jks
*.keystore

# Build-time secrets passed via --dart-define-from-file: the RevenueCat SDK
# keys. Publishable rather than secret, but they still do not belong in git —
# and env.example.json is here so the shape is not lost with them.
env.json
